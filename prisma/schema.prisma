// AI Lead Generation & Website Preview System — PostgreSQL schema.
// Connection string is read from DATABASE_URL (see prisma.config.ts).

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  admin
  operator
  viewer
}

enum CampaignStatus {
  draft
  running
  paused
  completed
  archived
}

enum WebsiteStatus {
  unknown
  no_website
  poor_website
  outdated
  good_website
  excellent_website
  unreachable
}

enum LeadStatus {
  discovered
  qualified
  rejected
  analyzing
  analyzed
  preview_generating
  preview_ready
  outreach_draft
  approved
  contacted
  replied
  interested
  not_interested
  converted
  suppressed
}

enum DeploymentStatus {
  pending
  building
  deployed
  failed
}

enum OutreachStatus {
  draft
  approved
  queued
  sent
  failed
  rejected
  cancelled
}

enum EmailEventType {
  sent
  delivered
  bounced
  complained
  opened
  clicked
  replied
  unsubscribed
}

enum FollowupStatus {
  scheduled
  drafted
  sent
  cancelled
  skipped
}

enum JobStatus {
  queued
  processing
  completed
  failed
}

// ───────────────────────────── Models ─────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(operator)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  approvedMessages OutreachMessage[] @relation("ApprovedBy")
  auditLogs        AuditLog[]
  campaigns        Campaign[]

  @@map("users")
}

model Campaign {
  id                     String         @id @default(uuid()) @db.Uuid
  name                   String
  category               String
  country                String
  region                 String?
  city                   String?
  status                 CampaignStatus @default(draft)
  maxLeads               Int            @default(50) @map("max_leads")
  dailyEmailLimit        Int            @default(20) @map("daily_email_limit")
  autoSendEnabled        Boolean        @default(false) @map("auto_send_enabled")
  autoGeneratePreview    Boolean        @default(true) @map("auto_generate_preview")
  autoGenerateDrafts     Boolean        @default(true) @map("auto_generate_drafts")
  /// Website statuses that qualify a lead, e.g. ["no_website","poor_website","outdated"]
  targetWebsiteStatuses  WebsiteStatus[] @default([no_website, poor_website, outdated]) @map("target_website_statuses")
  minLeadScore           Int            @default(50) @map("min_lead_score")
  /// Lead sources for discovery, e.g. ["google_places","openstreetmap","web_search"]. Empty = LEAD_PROVIDER env.
  leadSources            String[]       @default([]) @map("lead_sources")
  /// Provider cursor so each discovery run continues where the last one stopped ("done" = sources exhausted).
  discoveryCursor        String?        @map("discovery_cursor")
  createdById            String?        @map("created_by_id") @db.Uuid
  startedAt              DateTime?      @map("started_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  createdBy         User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  leads             Lead[]
  outreachMessages  OutreachMessage[]
  suppressions      CampaignSuppression[]

  @@index([status])
  @@index([category])
  @@index([country])
  @@map("campaigns")
}

model Lead {
  id                     String        @id @default(uuid()) @db.Uuid
  campaignId             String?       @map("campaign_id") @db.Uuid
  businessName           String        @map("business_name")
  normalizedName         String        @map("normalized_name")
  category               String
  address                String?
  normalizedAddress      String?       @map("normalized_address")
  city                   String?
  region                 String?
  country                String
  phone                  String?
  email                  String?
  websiteUrl             String?       @map("website_url")
  domain                 String?
  source                 String
  sourceExternalId       String?       @map("source_external_id")
  /// Where this business was found (listing / article URL) — shown for verification.
  sourceUrl              String?       @map("source_url")
  /// true = source page fetched and mentions the business; false = could not verify; null = structured API source
  sourceVerified         Boolean?      @map("source_verified")
  /// Every provider that returned this business (merged duplicates).
  sources                String[]      @default([])
  rating                 Float?
  reviewCount            Int?          @map("review_count")
  description            String?
  latitude               Float?
  longitude              Float?
  socialLinks            Json?         @map("social_links")
  websiteStatus          WebsiteStatus @default(unknown) @map("website_status")
  websiteStatusReasons   String[]      @default([]) @map("website_status_reasons")
  leadScore              Int           @default(0) @map("lead_score")
  status                 LeadStatus    @default(discovered)
  doNotContact           Boolean       @default(false) @map("do_not_contact")
  unsubscribed           Boolean       @default(false)
  emailConsentStatus     String        @default("unknown") @map("email_consent_status")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  analyses         LeadAnalysis[]
  websiteChecks    WebsiteCheck[]
  previews         WebsitePreview[]
  outreachMessages OutreachMessage[]
  followups        Followup[]
  events           LeadEvent[]

  @@unique([source, sourceExternalId])
  @@index([email])
  @@index([country])
  @@index([city])
  @@index([category])
  @@index([websiteStatus])
  @@index([status])
  @@index([leadScore])
  @@index([campaignId])
  @@index([domain])
  @@index([normalizedName, normalizedAddress])
  @@map("leads")
}

/// Timeline of notable lead changes (discovered, analyzed, email sent, status change...)
model LeadEvent {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_events")
}

model LeadAnalysis {
  id                  String   @id @default(uuid()) @db.Uuid
  leadId              String   @map("lead_id") @db.Uuid
  aiProvider          String   @map("ai_provider")
  model               String
  summary             String
  strengths           Json
  weaknesses          Json
  websiteOpportunity  String   @map("website_opportunity")
  recommendedFeatures Json     @map("recommended_features")
  recommendedSections Json?    @map("recommended_sections")
  tone                String?
  targetAudience      String?  @map("target_audience")
  suggestedCtas       Json     @map("suggested_ctas")
  confidence          Float
  inputHash           String?  @map("input_hash")
  rawResponse         Json     @map("raw_response")
  createdAt           DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([inputHash])
  @@map("lead_analysis")
}

model WebsiteCheck {
  id                    String   @id @default(uuid()) @db.Uuid
  leadId                String   @map("lead_id") @db.Uuid
  url                   String?
  finalUrl              String?  @map("final_url")
  reachable             Boolean
  statusCode            Int?     @map("status_code")
  responseTime          Int?     @map("response_time")
  sslValid              Boolean? @map("ssl_valid")
  mobileFriendly        Boolean? @map("mobile_friendly")
  hasContactInformation Boolean? @map("has_contact_information")
  hasMenu               Boolean? @map("has_menu")
  hasBooking            Boolean? @map("has_booking")
  hasSocialLinks        Boolean? @map("has_social_links")
  hasClearCta           Boolean? @map("has_clear_cta")
  contentScore          Int?     @map("content_score")
  designScore           Int?     @map("design_score")
  technicalScore        Int?     @map("technical_score")
  overallScore          Int?     @map("overall_score")
  websiteStatus         WebsiteStatus @map("website_status")
  reasons               String[] @default([])
  metadata              Json?
  checkedAt             DateTime @default(now()) @map("checked_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, checkedAt])
  @@map("website_checks")
}

model WebsiteTemplate {
  id                  String   @id @default(uuid()) @db.Uuid
  key                 String   @unique
  name                String
  category            String
  description         String
  repositoryPath      String   @map("repository_path")
  configurationSchema Json     @map("configuration_schema")
  version             Int      @default(1)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  previews WebsitePreview[]

  @@index([category])
  @@map("website_templates")
}

model WebsitePreview {
  id                 String           @id @default(uuid()) @db.Uuid
  leadId             String           @map("lead_id") @db.Uuid
  templateId         String           @map("template_id") @db.Uuid
  subdomain          String           @unique
  deploymentUrl      String?          @map("deployment_url")
  deploymentProvider String           @map("deployment_provider")
  deploymentStatus   DeploymentStatus @default(pending) @map("deployment_status")
  sourcePath         String?          @map("source_path")
  generatedContent   Json             @map("generated_content")
  version            Int              @default(1)
  lastDeployedAt     DateTime?        @map("last_deployed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  lead     Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  template WebsiteTemplate @relation(fields: [templateId], references: [id])

  @@index([leadId])
  @@index([deploymentStatus])
  @@map("website_previews")
}

model OutreachMessage {
  id             String         @id @default(uuid()) @db.Uuid
  leadId         String         @map("lead_id") @db.Uuid
  campaignId     String?        @map("campaign_id") @db.Uuid
  sequenceNumber Int            @default(0) @map("sequence_number")
  toEmail        String?        @map("to_email")
  subject        String
  body           String
  provider       String?
  status         OutreachStatus @default(draft)
  approvedById   String?        @map("approved_by") @db.Uuid
  approvedAt     DateTime?      @map("approved_at")
  sentAt         DateTime?      @map("sent_at")
  messageId      String?        @map("message_id")
  error          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  approvedBy User?        @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  events     EmailEvent[]
  followups  Followup[]

  @@index([leadId])
  @@index([campaignId, sentAt])
  @@index([status])
  @@index([messageId])
  @@map("outreach_messages")
}

model EmailEvent {
  id                String         @id @default(uuid()) @db.Uuid
  outreachMessageId String         @map("outreach_message_id") @db.Uuid
  eventType         EmailEventType @map("event_type")
  providerEventId   String?        @unique @map("provider_event_id")
  metadata          Json?
  occurredAt        DateTime       @default(now()) @map("occurred_at")

  outreachMessage OutreachMessage @relation(fields: [outreachMessageId], references: [id], onDelete: Cascade)

  @@index([outreachMessageId])
  @@index([eventType])
  @@map("email_events")
}

model Followup {
  id                String         @id @default(uuid()) @db.Uuid
  leadId            String         @map("lead_id") @db.Uuid
  previousMessageId String         @map("previous_message_id") @db.Uuid
  sequenceNumber    Int            @map("sequence_number")
  scheduledAt       DateTime       @map("scheduled_at")
  status            FollowupStatus @default(scheduled)
  reason            String?
  createdAt         DateTime       @default(now()) @map("created_at")

  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousMessage OutreachMessage @relation(fields: [previousMessageId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([leadId])
  @@map("followups")
}

model SuppressionEntry {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  reason    String
  source    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("suppression_list")
}

model CampaignSuppression {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  email      String
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([email])
  @@map("campaign_suppressions")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  queueJobId  String?   @map("queue_job_id")
  type        String
  status      JobStatus @default(queued)
  payload     Json
  attempts    Int       @default(0)
  error       String?
  leadId      String?   @map("lead_id") @db.Uuid
  campaignId  String?   @map("campaign_id") @db.Uuid
  durationMs  Int?      @map("duration_ms")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([type])
  @@index([leadId])
  @@map("jobs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Singleton-ish key/value settings editable from the admin UI (non-secret values only).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Cache for AI responses keyed by prompt hash — avoids paying twice for identical input.
model AiCache {
  key       String   @id
  model     String
  response  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_cache")
}
