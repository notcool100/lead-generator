# ── Core ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_lead
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
# Used to sign session cookies and unsubscribe tokens (openssl rand -base64 32)
NEXTAUTH_SECRET=

# ── AI ───────────────────────────────────────────────
# claude_code = use your Claude subscription via the logged-in Claude Code CLI (this machine only)
# anthropic   = Anthropic API key (required for servers/Docker)   | openai | mock
AI_PROVIDER=claude_code
CLAUDE_CODE_MODEL=opus
CLAUDE_CODE_SMALL_MODEL=haiku
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Strong model for analysis / copywriting, small model for classification
AI_MODEL=claude-opus-5
AI_SMALL_MODEL=claude-haiku-4-5

# ── Lead discovery ───────────────────────────────────
# Default lead sources (comma-separated, per-campaign override in the wizard):
#   google_places, apify_google_maps, openstreetmap, web_search (Claude web search, needs claude_code), yelp, mock
LEAD_PROVIDER=openstreetmap,web_search
# Max new leads per discovery run
DISCOVERY_BATCH_SIZE=20
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
# Apify (https://console.apify.com/settings/integrations): Google Maps source + Facebook-page email lookup
APIFY_API_TOKEN=
# Look up emails on Facebook pages for targeted leads that have none (costs Apify credits per lead)
APIFY_FACEBOOK_ENRICHMENT=true
# Overpass mirrors tried in order; OSM_CONTACT is sent in the User-Agent (OSM usage policy)
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter
OSM_CONTACT=

# ── Email ────────────────────────────────────────────
# smtp (your own server, e.g. mailcow) | resend | sendgrid | ses | log (log = never sends)
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM="Your Name <you@example.com>"
EMAIL_REPLY_TO=you@example.com
# Shared secret used to verify POST /api/webhooks/email (HMAC-SHA256 of raw body)
EMAIL_WEBHOOK_SECRET=
# AWS SES only
# EMAIL_PROVIDER=smtp
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=outreach@yourdomain.com
SMTP_PASSWORD=
# Inbox sync: replies, unsubscribe requests and bounces are read from this mailbox every 2 minutes
IMAP_HOST=mail.yourdomain.com
IMAP_PORT=993
IMAP_USER=outreach@yourdomain.com
IMAP_PASSWORD=
AWS_REGION=

# ── AI cold calling (Retell + Twilio) ────────────────
# 1. Buy a number in Twilio, then import it into Retell (Phone Numbers → Import / Twilio integration).
# 2. Set RETELL_API_KEY + RETELL_FROM_NUMBER, then run `pnpm retell:setup` to create the agent
#    (prompt, voice, post-call analysis, webhook {APP_URL}/api/webhooks/retell) and print RETELL_AGENT_ID.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# ── Previews ─────────────────────────────────────────
# Previews are served at  {APP_URL}/p/{slug}  or  {slug}.{PREVIEW_BASE_DOMAIN}
PREVIEW_BASE_DOMAIN=
# vps | static | vercel | cloudflare_pages
DEPLOYMENT_PROVIDER=vps
DEPLOYMENT_API_KEY=
PREVIEW_OUTPUT_DIR=./storage/previews

# ── Stock photos for previews (free keys: unsplash.com/developers, pexels.com/api) ──
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── Bootstrap admin (used by `pnpm db:seed`) ─────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
